---
/**
 * OptimizedImage Component
 * Handles image optimization for both external (Unsplash) and local images
 * Provides lazy loading, responsive images, and prevents layout shift
 * Automatically falls back to placeholder if image URL is missing/invalid
 */
import { optimizeImageUrl, supportsResponsiveSrcset, generateSrcset, getImageUrl, PLACEHOLDER_IMAGE } from '../utils/imageUtils';

interface Props {
  src: string | null | undefined;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string; // Responsive sizes attribute
  quality?: number;
  srcsetSizes?: number[]; // Array of widths for srcset generation
  priority?: boolean; // LCP image: eager + fetchpriority=high
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  sizes,
  quality = 75,
  srcsetSizes,
  priority = false,
} = Astro.props;

// Get valid image URL (falls back to placeholder if null/undefined/empty)
const validSrc = getImageUrl(src);
const isPlaceholder = validSrc === PLACEHOLDER_IMAGE;

// Host-aware optimization: Unsplash + Cloudinary are resized (and get srcset), other hosts pass through unchanged
const canResize = !isPlaceholder && supportsResponsiveSrcset(validSrc);
const optimizedSrc = optimizeImageUrl(validSrc, width, height, quality);

const srcset =
  canResize && srcsetSizes && srcsetSizes.length > 0
    ? generateSrcset(validSrc, srcsetSizes, height / width, quality)
    : undefined;
// sizes only makes sense together with srcset
const sizesAttr = srcset ? sizes : undefined;

const loadingAttr = priority ? 'eager' : loading;

// Calculate aspect ratio for CSS to prevent CLS
const aspectRatio = (height / width) * 100;
---

<div class={`relative overflow-hidden bg-[#1f1f1f] ${className}`} style={`aspect-ratio: ${width} / ${height};`}>
  <img
    src={optimizedSrc}
    alt={alt}
    width={width}
    height={height}
    loading={loadingAttr}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
    srcset={srcset}
    sizes={sizesAttr}
    class="w-full h-full object-cover"
  />
</div>

<style>
  /* Fallback for browsers that don't support aspect-ratio */
  @supports not (aspect-ratio: 1 / 1) {
    div {
      position: relative;
    }
    div::before {
      content: '';
      display: block;
      padding-top: calc(var(--aspect-ratio) * 1%);
    }
    img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
  }
</style>
